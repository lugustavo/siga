# Telegram (alertas; sem isto o bot so escreve nos logs)
BOT_TOKEN=
BOT_CHAT_ID=

# 1 = so le os horarios e avisa (NAO clica em Marcar)   <- por omissao
# 2 = clica em Marcar e preenche o formulario, sem CAPTCHA nem submissao
# 0 = marca a serio (pesquisas com auto_book: true)
DRY_RUN=1
# Depois de uma marcacao, nenhuma outra e feita
STOP_AFTER_BOOKING=1
# Falhas de marcacao seguidas antes de desligar o auto_book dessa pesquisa
MAX_ATTEMPTS=3

# CAPTCHA: tempo (s) que o bot espera que resolvas o desafio de imagens
CAPTCHA_WAIT_S=300
# noVNC: palavra-passe (so os 8 primeiros caracteres contam) e o URL que vai no aviso
VNC_PASSWORD=
NOVNC_URL=http://IP-DO-SERVIDOR:6080/vnc.html?autoconnect=1&resize=scale
# IP onde publicar a porta 6080 (por omissao 127.0.0.1)
NOVNC_BIND=127.0.0.1

# PIN por IMAP (Gmail): ativar IMAP e gerar app password em https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# O popup do SIGA dura 5 minutos: IMAP + fallback Telegram tem de caber nisso
PIN_TIMEOUT_S=240
